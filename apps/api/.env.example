PROJECT_NAME="Kinetix Home Care API"
VERSION="1.0"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS_COUNT=1

# CORS
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Database
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/kinetix"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Security (JWT)
# Use RS256 architecture as requested, but for local dev provide dummy keys
# Note: In production these should be actual RS256 key pairs, or you can switch
# ALGORITHM to HS256 for local dev if preferred by settings.
SECRET_KEY="supersecretkey-please-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="console"  # 'json' for production
